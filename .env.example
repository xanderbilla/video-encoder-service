# Server Configuration
PORT=8080
SHUTDOWN_TIMEOUT=30

# Worker Configuration
MAX_WORKERS=2
MAX_RETRIES=3
HEARTBEAT_INTERVAL=10
ORPHAN_TIMEOUT=60

# Storage Paths
OUTPUTS_DIR=outputs
CHUNKS_DIR=chunks
CACHE_DIR=cache
TMP_DIR=tmp
VIDEOS_DIR=videos
LOGS_DIR=logs

# Encoding Configuration
MAX_FILE_SIZE_MB=1024
MAX_JOB_SIZE_MB=1500
MAX_WIDTH=3840
MAX_HEIGHT=2160
DEFAULT_CHUNK_DURATION=4

# Disk Management
DISK_THRESHOLD_PERCENT=80
DISK_HARD_LIMIT_PERCENT=90
CLEANUP_INTERVAL=600
